{
  "name": "naf/monitoring",
  "description": "Metrics, StatsD exporters and optional PSR-3 logging integration for NAF.",
  "type": "naf-plugin",
  "license": "MIT",
  "require": {
    "php": ">=8.3",
    "naf/framework": "^0.2.3",
    "psr/log": "^3.0"
  },
  "autoload": {
    "psr-4": { "Naf\\Monitoring\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Tests\\": "tests/" }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5 || ^12.1"
  },
  "scripts": {
    "test": [
      "@php vendor/bin/phpunit --colors=always",
      "@php tests/host.php",
      "@php tests/http.php"
    ]
  }
}
